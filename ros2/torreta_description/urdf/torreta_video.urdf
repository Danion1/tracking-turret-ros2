  <joint name="pan_motor" type="revolute">
    <parent link="base_link" />
    <child link="pinhao_pan" />
    <origin xyz="0.0116469 0.0434667 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="1.80893" velocity="5.15933" />
  </joint>

  <joint name="pan" type="revolute">
    <parent link="base_link" />
    <child link="pan_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.6057" upper="1.6057" effort="3.61786" velocity="2.57967" />
    <mimic joint="pan_motor" multiplier="-0.5" offset="0" />
  </joint>

  <joint name="tilt" type="revolute">
